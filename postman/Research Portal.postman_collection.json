      "key": "id3",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Create opportunity 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Crop health classification\",\n  \"description\": \"Analyze crop images and develop machine learning models with the faculty team.\",\n  \"research_area\": \"Artificial Intelligence\",\n  \"faculty_name\": \"Dr. Ayesha Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, machine learning\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2027-01-31\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('id1', body.data.id);",
              "pm.test('ID and default fields', () => { pm.expect(body.data.id).to.be.a('number'); pm.expect(body.data.status).to.eql('Open'); });"
            ]
          }
        }
      ]
    },
