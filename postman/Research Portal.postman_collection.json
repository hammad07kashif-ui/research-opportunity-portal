{
  "info": {
    "name": "P24-0631 - Hammad Kashif - Research Opportunity Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against the running MySQL-backed application. Creates three records and cleans up only those records. Expected 404 and 400 requests are successful validation demonstrations."
  },
